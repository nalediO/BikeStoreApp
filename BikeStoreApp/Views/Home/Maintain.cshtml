@{
    ViewBag.Title = "Maintain Records - BikeStores";
}

<div class="container-fluid mt-4">
    <h2 class="text-center fw-bold mb-4">Maintain Records</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
             @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Staff Management</h5>
                    <button class="btn btn-light btn-sm" data-bs-toggle="collapse" data-bs-target="#staffCards">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
                <div id="staffCards" class="collapse show">
                    <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                        @if (ViewBag.Staffs != null && ViewBag.Staffs.Count > 0)
                        {
                            foreach (var s in ViewBag.Staffs)
                            {
                                <div class="border rounded p-3 mb-3 bg-light">
                                    <h6 class="fw-bold text-primary mb-2">@s.first_name @s.last_name</h6>
                                    <p class="mb-1"><strong>Email:</strong> @s.email</p>
                                    <p class="mb-1"><strong>Phone:</strong> @(s.phone ?? "N/A")</p>
                                    <p class="mb-1"><strong>Store:</strong> @(s.store != null ? s.store.store_name : "N/A")</p>
                                    <p class="mb-1"><strong>Active:</strong> @(s.active == 1 ? "Yes" : "No")</p>
                                    <p class="mb-2"><strong>Manager:</strong> @(s.staff1 != null ? s.staff1.first_name + " " + s.staff1.last_name : "None")</p>

                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-sm btn-warning edit-staff"
                                                data-id="@s.staff_id"
                                                data-fname="@s.first_name"
                                                data-lname="@s.last_name"
                                                data-email="@s.email"
                                                data-phone="@s.phone"
                                                data-active="@s.active"
                                                data-store="@s.store_id"
                                                data-manager="@s.manager_id"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editStaffModal">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <a href="@Url.Action("DeleteStaff", new { id = s.staff_id })"
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Are you sure you want to delete this staff member?');">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center">No staff members found.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

    
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm border-success h-100">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Customer Management</h5>
                    <button class="btn btn-light btn-sm" data-bs-toggle="collapse" data-bs-target="#customerCards">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
                <div id="customerCards" class="collapse show">
                    <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                        @if (ViewBag.Customers != null && ViewBag.Customers.Count > 0)
                        {
                            foreach (var c in ViewBag.Customers)
                            {
                                <div class="border rounded p-3 mb-3 bg-light">
                                    <h6 class="fw-bold text-success mb-2">@c.first_name @c.last_name</h6>
                                    <p class="mb-1"><strong>Email:</strong> @c.email</p>
                                    <p class="mb-1"><strong>Phone:</strong> @(c.phone ?? "N/A")</p>
                                    <p class="mb-1"><strong>Street:</strong> @(c.street ?? "N/A")</p>
                                    <p class="mb-1"><strong>City:</strong> @c.city</p>
                                    <p class="mb-1"><strong>State:</strong> @c.state</p>
                                    <p class="mb-2"><strong>Zip Code:</strong> @(c.zip_code ?? "N/A")</p>

                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-sm btn-warning edit-customer"
                                                data-id="@c.customer_id"
                                                data-fname="@c.first_name"
                                                data-lname="@c.last_name"
                                                data-email="@c.email"
                                                data-phone="@c.phone"
                                                data-street="@c.street"
                                                data-city="@c.city"
                                                data-state="@c.state"
                                                data-zip="@c.zip_code"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCustomerModal">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <a href="@Url.Action("DeleteCustomer", new { id = c.customer_id })"
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Are you sure you want to delete this customer?');">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center">No customers found.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        
        <div class="col-lg-4 col-md-12">
            <div class="card shadow-sm border-info h-100">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"> Product Management</h5>
                    <button class="btn btn-light btn-sm" data-bs-toggle="collapse" data-bs-target="#productCards">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
                <div id="productCards" class="collapse show">
                    <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                        @if (ViewBag.Products != null && ViewBag.Products.Count > 0)
                        {
                            foreach (var p in ViewBag.Products)
                            {
                                var img = ViewBag.ProductImages != null && ViewBag.ProductImages.ContainsKey(p.product_id)
                                    ? ViewBag.ProductImages[p.product_id]
                                    : Url.Content("~/Bikes_Images/default_bike.jpeg");

                                <div class="border rounded p-3 mb-3 bg-light text-center">
                                    <img src="@img" class="img-fluid mb-2 rounded" style="height:120px; object-fit:cover;" alt="@p.product_name" />
                                    <h6 class="fw-bold text-info mb-2">@p.product_name</h6>
                                    <p class="mb-1"><strong>Brand:</strong> @(p.brand != null ? p.brand.brand_name : "N/A")</p>
                                    <p class="mb-1"><strong>Category:</strong> @(p.category != null ? p.category.category_name : "N/A")</p>
                                    <p class="mb-1"><strong>Model Year:</strong> @p.model_year</p>
                                    <p class="mb-2"><strong>Price:</strong> R @p.list_price.ToString("N2")</p>

                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-sm btn-warning edit-product"
                                                data-id="@p.product_id"
                                                data-name="@p.product_name"
                                                data-model="@p.model_year"
                                                data-price="@p.list_price"
                                                data-brand="@p.brand_id"
                                                data-category="@p.category_id"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editProductModal">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <a href="@Url.Action("DeleteProduct", new { id = p.product_id })"
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Are you sure you want to delete this product?');">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center">No products found.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="editStaffModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("EditStaff")">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Edit Staff Member</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="staff_id" id="staff_id" />

                    <div class="mb-3">
                        <label class="form-label">First Name *</label>
                        <input type="text" name="first_name" id="first_name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Last Name *</label>
                        <input type="text" name="last_name" id="last_name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email *</label>
                        <input type="email" name="email" id="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="phone" id="phone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Active</label>
                        <select name="active" id="active" class="form-select">
                            <option value="1">Yes</option>
                            <option value="0">No</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Store *</label>
                        <select name="store_id" id="store_id" class="form-select" required>
                            @foreach (var store in ViewBag.Stores)
                            {
                                <option value="@store.store_id">@store.store_name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Manager</label>
                        <select name="manager_id" id="manager_id" class="form-select">
                            <option value="">None</option>
                            @foreach (var mgr in ViewBag.AllStaff)
                            {
                                <option value="@mgr.staff_id">@mgr.first_name @mgr.last_name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Staff</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="editCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("EditCustomer")">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Edit Customer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="customer_id" id="customer_id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name *</label>
                            <input type="text" name="first_name" id="cust_first_name" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name *</label>
                            <input type="text" name="last_name" id="cust_last_name" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" id="cust_email" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="phone" id="cust_phone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Street</label>
                        <input type="text" name="street" id="street" class="form-control" />
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">City</label>
                            <input type="text" name="city" id="city" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">State</label>
                            <input type="text" name="state" id="state" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Zip Code</label>
                            <input type="text" name="zip_code" id="zip_code" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Update Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="editProductModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("EditProduct")">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">Edit Product</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="product_id" id="product_id" />

                    <div class="mb-3">
                        <label class="form-label">Product Name *</label>
                        <input type="text" name="product_name" id="product_name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Brand *</label>
                        <select name="brand_id" id="brand_id" class="form-select" required>
                            @foreach (var brand in ViewBag.Brands)
                            {
                                <option value="@brand.brand_id">@brand.brand_name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category *</label>
                        <select name="category_id" id="category_id" class="form-select" required>
                            @foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.category_id">@cat.category_name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Model Year *</label>
                        <input type="number" name="model_year" id="model_year" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">List Price (R) *</label>
                        <input type="number" step="0.01" name="list_price" id="list_price" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info">Update Product</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById("editStaffModal").addEventListener("show.bs.modal", function (event) {
        var button = event.relatedTarget;
        document.getElementById("staff_id").value = button.dataset.id;
        document.getElementById("first_name").value = button.dataset.fname;
        document.getElementById("last_name").value = button.dataset.lname;
        document.getElementById("email").value = button.dataset.email;
        document.getElementById("phone").value = button.dataset.phone || "";
        document.getElementById("active").value = button.dataset.active;
        document.getElementById("store_id").value = button.dataset.store;
        document.getElementById("manager_id").value = button.dataset.manager || "";
    });

    document.getElementById("editCustomerModal").addEventListener("show.bs.modal", function (event) {
        var button = event.relatedTarget;
        document.getElementById("customer_id").value = button.dataset.id;
        document.getElementById("cust_first_name").value = button.dataset.fname;
        document.getElementById("cust_last_name").value = button.dataset.lname;
        document.getElementById("cust_email").value = button.dataset.email || "";
        document.getElementById("cust_phone").value = button.dataset.phone || "";
        document.getElementById("street").value = button.dataset.street || "";
        document.getElementById("city").value = button.dataset.city || "";
        document.getElementById("state").value = button.dataset.state || "";
        document.getElementById("zip_code").value = button.dataset.zip || "";
    });

    document.getElementById("editProductModal").addEventListener("show.bs.modal", function (event) {
        var button = event.relatedTarget;
        document.getElementById("product_id").value = button.dataset.id;
        document.getElementById("product_name").value = button.dataset.name;
        document.getElementById("model_year").value = button.dataset.model;
        document.getElementById("list_price").value = button.dataset.price;
        document.getElementById("brand_id").value = button.dataset.brand;
        document.getElementById("category_id").value = button.dataset.category;
    });
</script>