@model BikeStoreApp.Models.product
@{
    ViewBag.Title = "Delete Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card border-danger shadow-sm p-4">
        <h2 class="text-danger">Delete Product</h2>
        <p class="text-muted">Are you sure you want to delete this product?</p>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">Product Name</dt>
            <dd class="col-sm-9">@Model.product_name</dd>

            <dt class="col-sm-3">Model Year</dt>
            <dd class="col-sm-9">@Model.model_year</dd>

            <dt class="col-sm-3">List Price</dt>
            <dd class="col-sm-9">R @Model.list_price.ToString("N2")</dd>

            <dt class="col-sm-3">Brand</dt>
            <dd class="col-sm-9">@Model.brand?.brand_name</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.category?.category_name</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-end mt-4">
                <input type="submit" value="Confirm Delete" class="btn btn-danger me-2" />
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        }
    </div>
</div>
