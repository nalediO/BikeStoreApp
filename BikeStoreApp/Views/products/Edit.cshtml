@model BikeStoreApp.Models.product
@{
    ViewBag.Title = "Edit Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-primary mb-3">Edit Product</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.product_id)

        <div class="card shadow-sm p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.product_name, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.product_name, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.brand_id, "Brand", new { @class = "form-label fw-bold" })
                    @Html.DropDownList("brand_id", null, "Select Brand", new { @class = "form-select" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.category_id, "Category", new { @class = "form-label fw-bold" })
                    @Html.DropDownList("category_id", null, "Select Category", new { @class = "form-select" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.model_year, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.model_year, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.list_price, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.list_price, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>

            <div class="mt-4 text-end">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary ms-2" })
            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
