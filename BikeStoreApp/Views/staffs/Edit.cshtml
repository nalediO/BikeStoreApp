@model BikeStoreApp.Models.staff
@{
    ViewBag.Title = "Edit Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-primary mb-3">Edit Staff Member</h2>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.staff_id)

        <div class="card shadow-sm p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.first_name, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.first_name, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.last_name, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.last_name, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.email, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.email, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.phone, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.phone, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.active, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.active, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.store_id, "Store", new { @class = "form-label fw-bold" })
                    @Html.DropDownList("store_id", null, "Select Store", new { @class = "form-select" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.manager_id, "Manager", new { @class = "form-label fw-bold" })
                    @Html.DropDownList("manager_id", null, "Select Manager", new { @class = "form-select" })
                </div>
            </div>

            <div class="mt-4 text-end">
                <input type="submit" value=" Save Changes" class="btn btn-primary" />
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary ms-2" })
            </div>
        </div>
    }
</div>
