@model IEnumerable<BikeStoreApp.Models.staff>

@{
    ViewBag.Title = "Staff List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">Staff Members</h2>
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success" })
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.first_name)</th>
                        <th>@Html.DisplayNameFor(model => model.last_name)</th>
                        <th>@Html.DisplayNameFor(model => model.email)</th>
                        <th>@Html.DisplayNameFor(model => model.phone)</th>
                        <th>@Html.DisplayNameFor(model => model.active)</th>
                        <th>@Html.DisplayNameFor(model => model.staff1.first_name)</th>
                        <th>@Html.DisplayNameFor(model => model.store.store_name)</th>
                        <th class="text-center" style="width: 200px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.first_name)</td>
                            <td>@Html.DisplayFor(modelItem => item.last_name)</td>
                            <td>@Html.DisplayFor(modelItem => item.email)</td>
                            <td>@Html.DisplayFor(modelItem => item.phone)</td>
                            <td>@Html.DisplayFor(modelItem => item.active)</td>
                            <td>@Html.DisplayFor(modelItem => item.staff1.first_name)</td>
                            <td>@Html.DisplayFor(modelItem => item.store.store_name)</td>
                            <td class="text-center">
                                @Html.ActionLink("Edit", "Edit", new { id = item.staff_id }, new { @class = "btn btn-sm btn-warning me-1" })
                                @Html.ActionLink("Details", "Details", new { id = item.staff_id }, new { @class = "btn btn-sm btn-info me-1 text-white" })
                                @Html.ActionLink("Delete", "Delete", new { id = item.staff_id }, new { @class = "btn btn-sm btn-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
