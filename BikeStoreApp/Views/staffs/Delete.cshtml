@model BikeStoreApp.Models.staff
@{
    ViewBag.Title = "Delete Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card border-danger shadow-sm p-4">
        <h2 class="text-danger"> Delete Staff</h2>
        <p class="text-muted">Are you sure you want to delete this staff member?</p>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.first_name @Model.last_name</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.email</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.phone</dd>

            <dt class="col-sm-3">Store</dt>
            <dd class="col-sm-9">@Model.store?.store_name</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-end mt-4">
                <input type="submit" value=" Confirm Delete" class="btn btn-danger me-2" />
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        }
    </div>
</div>
