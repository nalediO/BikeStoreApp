@model BikeStoreApp.Models.customer
@{
    ViewBag.Title = "Edit Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-primary mb-3">Edit Customer</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.customer_id)

        <div class="card shadow-sm p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.first_name, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.first_name, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.last_name, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.last_name, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.phone, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.phone, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.email, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.email, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.street, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.street, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.city, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.city, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.state, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.state, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.zip_code, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.zip_code, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>

            <div class="mt-4 text-end">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary ms-2" })
            </div>
        </div>
    }
</div>
