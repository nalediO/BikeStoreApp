
@{
    ViewBag.Title = "_CreateStaffModel";
}

<div class="modal fade" id="createStaffModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Add New Staff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("Create", "staffs", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-2">
                        @Html.Label("First Name")
                        @Html.TextBox("first_name", null, new { @class = "form-control" })
                    </div>
                    <div class="form-group mb-2">
                        @Html.Label("Last Name")
                        @Html.TextBox("last_name", null, new { @class = "form-control" })
                    </div>
                    <div class="form-group mb-2">
                        @Html.Label("Email")
                        @Html.TextBox("email", null, new { @class = "form-control" })
                    </div>
                    <div class="form-group mb-2">
                        @Html.Label("Phone")
                        @Html.TextBox("phone", null, new { @class = "form-control" })
                    </div>
                    <div class="form-group mb-2">
                        @Html.Label("Active")
                        @Html.CheckBox("active", true)
                    </div>
                    <div class="form-group mb-2">
                        @Html.Label("Store")
                        @Html.DropDownList("store_id", ViewBag.store_id as SelectList, "Select Store", new { @class = "form-control" })
                    </div>
                    <div class="form-group mb-2">
                        @Html.Label("Manager")
                        @Html.DropDownList("manager_id", ViewBag.manager_id as SelectList, "Select Manager", new { @class = "form-control" })
                    </div>
                    <button type="submit" class="btn btn-primary mt-2">Save</button>
                }
            </div>
        </div>
    </div>
</div>



